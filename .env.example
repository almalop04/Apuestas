# ==============================================================================
# CONFIGURACIÓN DE APIS DEPORTIVAS Y CONTROL DE CUOTAS
# ==============================================================================
# Copia este archivo como .env.local y rellena tus claves si dispones de ellas.
# Si no introduces claves, el sistema funcionará automáticamente en MODO SIMULADO (MOCK)
# con datos realistas para que puedas probar la aplicación al 100% sin pagar un céntimo.

# Modo de datos: 'mock' (simulado) o 'live' (conectado a proveedores reales)
DATA_MODE=mock

# Proveedor de Fútbol (por ejemplo API-Football / RapidAPI)
FOOTBALL_API_KEY=
FOOTBALL_API_HOST=v3.football.api-sports.io

# Proveedor de Baloncesto (por ejemplo Balldontlie / RapidAPI)
BASKETBALL_API_KEY=
BASKETBALL_API_HOST=api.balldontlie.io

# Límites de seguridad diaria de peticiones (para evitar sobrecostes o bloqueos)
DAILY_QUOTA_LIMIT=100
QUOTA_WARNING_THRESHOLD=80

# Caché (Tiempo de vida en segundos por tipo de dato)
CACHE_TTL_LIVE_MATCHES=60
CACHE_TTL_FINISHED_MATCHES=86400
CACHE_TTL_HISTORICAL_STATS=604800
